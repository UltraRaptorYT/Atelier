# Minimal Next.js template. See .env.example for the complete annotated guide.
# Copy to .env.local (do not overwrite a configured file).
# Leave Clerk blank for loopback development; configure both for sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ATELIER_WORKER_URL=http://127.0.0.1:8787
# Only enabled for loopback local development; never enabled in production.
ATELIER_LOCAL_DEVELOPMENT=true
